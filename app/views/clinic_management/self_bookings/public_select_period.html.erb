<%# Public self-booking step 3: choose a service/time before identification. %>

<div class="step-indicator" aria-label="Etapa 3 de 4">
  <div class="step-dot completed"></div>
  <div class="step-dot completed"></div>
  <div class="step-dot active"></div>
  <div class="step-dot"></div>
</div>

<% unless session[:self_booking_pinned_service_id].present? %>
  <%= link_to public_booking_select_day_path(week: @week), class: "back-btn" do %>
    <i class="fas fa-arrow-left" aria-hidden="true"></i>
    Voltar
  <% end %>
<% end %>

<div class="booking-card">
  <h1 class="text-xl font-bold text-gray-900 text-center mb-2">Qual horário?</h1>
  <p class="text-gray-600 text-center mb-6 capitalize"><%= @day_name %></p>

  <% if @public_booking_total_options.positive? %>
    <% if @public_booking_total_options <= ClinicManagement::SelfBookingsController::PUBLIC_BOOKING_OPTIONS_PER_PAGE %>
      <div class="flex items-center gap-3 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 mb-5 text-amber-800" role="status">
        <i class="far fa-clock" aria-hidden="true"></i>
        <span class="text-sm font-medium">Poucos horários disponíveis neste dia</span>
      </div>
    <% elsif @public_booking_slot_page.zero? %>
      <h2 class="text-sm font-semibold text-gray-600 mb-3">Horários recomendados</h2>
    <% else %>
      <h2 class="text-sm font-semibold text-gray-600 mb-3">Outras opções</h2>
    <% end %>

    <div class="space-y-3">
      <% @public_booking_options.each do |option| %>
        <%= render "public_booking_option", option: option, week: @week, day: @day %>
      <% end %>
    </div>

    <% if @public_booking_has_next_page || @public_booking_slot_page.positive? %>
      <% target_page = @public_booking_has_next_page ? @public_booking_slot_page + 1 : 0 %>
      <% target_path = if session[:self_booking_pinned_service_id].present?
        public_booking_path(continue: 1, slot_page: target_page)
      else
        public_booking_select_period_path(week: @week, day: @day, slot_page: target_page)
      end %>
      <%= link_to target_path, class: "btn-secondary mt-5" do %>
        <span><%= @public_booking_has_next_page ? "Ver outras opções" : "Voltar aos recomendados" %></span>
        <i class="fas <%= @public_booking_has_next_page ? 'fa-chevron-down' : 'fa-chevron-up' %> ml-2" aria-hidden="true"></i>
      <% end %>
    <% end %>

    <p class="text-sm text-gray-500 text-center mt-5">
      <i class="fas fa-sync-alt mr-1" aria-hidden="true"></i>
      A agenda é atualizada em tempo real
    </p>

    <% unless session[:self_booking_pinned_service_id].present? %>
      <%= link_to "Escolher outro dia",
                  public_booking_select_day_path(week: @week),
                  class: "block text-center text-emerald-700 font-medium mt-4" %>
    <% end %>
  <% else %>
    <div class="text-center py-8">
      <i class="fas fa-clock text-gray-400 text-3xl mb-3" aria-hidden="true"></i>
      <h2 class="text-lg font-semibold text-gray-700 mb-2">Sem horários disponíveis</h2>
      <p class="text-gray-500">Volte e escolha outro dia.</p>
    </div>
  <% end %>
</div>
