<%# Public self-booking step 3: choose a service/time before identification. %>

<div class="step-indicator" aria-label="Etapa 3 de 4">
  <div class="step-dot completed"></div>
  <div class="step-dot completed"></div>
  <div class="step-dot active"></div>
  <div class="step-dot"></div>
</div>

<% unless session[:self_booking_pinned_service_id].present? %>
  <%= link_to public_booking_select_day_path(week: @week), class: "back-btn" do %>
    <i class="fas fa-arrow-left" aria-hidden="true"></i>
    Voltar
  <% end %>
<% end %>

<div class="booking-card">
  <h1 class="text-xl font-bold text-gray-900 text-center mb-2">Qual horário?</h1>
  <p class="text-gray-600 text-center mb-6 capitalize"><%= @day_name %></p>

  <% if @morning_services.any? || @afternoon_services.any? %>
    <div class="space-y-3">
      <% (@morning_services + @afternoon_services).each do |service| %>
        <% if service.scheduled? %>
          <% service.available_start_times.each do |time| %>
            <%= link_to public_booking_path(continue: 1, service_id: service.id, scheduled_at: time.iso8601, week: @week, day: @day), class: "option-btn" do %>
              <div class="flex items-center">
                <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center mr-3">
                  <i class="fas fa-clock text-emerald-600" aria-hidden="true"></i>
                </div>
                <div class="text-left">
                  <div class="font-semibold text-gray-900"><%= time.strftime("%H:%M") %></div>
                  <div class="text-sm text-gray-500 capitalize"><%= I18n.l(service.date, format: "%A, %d/%m") %></div>
                </div>
              </div>
              <i class="fas fa-chevron-right icon" aria-hidden="true"></i>
            <% end %>
          <% end %>
        <% else %>
          <%= link_to public_booking_path(continue: 1, service_id: service.id, week: @week, day: @day), class: "option-btn" do %>
            <div class="flex items-center">
              <div class="w-10 h-10 <%= service.start_time.hour < 12 ? 'bg-amber-100' : 'bg-blue-100' %> rounded-full flex items-center justify-center mr-3">
                <i class="fas <%= service.start_time.hour < 12 ? 'fa-sun text-amber-500' : 'fa-moon text-blue-500' %>" aria-hidden="true"></i>
              </div>
              <div class="text-left">
                <div class="font-semibold text-gray-900 capitalize"><%= I18n.l(service.date, format: "%A, %d/%m") %></div>
                <div class="text-sm text-gray-500"><%= service.start_time.strftime("%H:%M") %> - <%= service.end_time.strftime("%H:%M") %></div>
              </div>
            </div>
            <i class="fas fa-chevron-right icon" aria-hidden="true"></i>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-8">
      <i class="fas fa-clock text-gray-400 text-3xl mb-3" aria-hidden="true"></i>
      <h2 class="text-lg font-semibold text-gray-700 mb-2">Sem horários disponíveis</h2>
      <p class="text-gray-500">Volte e escolha outro dia.</p>
    </div>
  <% end %>
</div>
