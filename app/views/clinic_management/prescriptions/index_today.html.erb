<%# Toggle for table/cards view. Stores preference in a cookie. %>
<%= render partial: "clinic_management/shared/toggle_cards_table", locals: { 
      path: ->(args = {}) { clinic_management.index_today_path(args) }, 
      cookie_name: "preferred_prescriptions_today_view", 
      view_type: @view_type 
    } %>

<% unless doctor?(current_user)%>

      <div class="bg-white rounded-lg shadow-md p-4 mb-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-3">
          <h3 class="text-lg font-medium text-gray-800">Ordem da fila para impressão</h3>
          
          <div class="mt-2 sm:mt-0">
            <button id="toggleOrderNumbers" class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded text-sm transition-colors duration-200">
              Mostrar/Ocultar números
            </button>
            
            <select id="quickJump" class="ml-2 border border-gray-300 rounded px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="">Ir para...</option>
              <% (1..40).each do |i| %>
                <option value="<%= i %>"><%= i %></option>
              <% end %>
            </select>
          </div>
        </div>
        
        <div id="orderNumbersContainer" class="hidden">
          <div class="grid grid-cols-10 gap-2">
            <% 40.times do |i| %>
              <%= link_to "#{i+1}", 
                  generate_order_pdf_path(order_number: i+1, format: :pdf), 
                  class: "text-center py-2 rounded bg-gray-100 hover:bg-blue-100 text-blue-600 hover:text-blue-800 transition-colors duration-200", 
                  target: "_blank" %>
            <% end %>
          </div>
        </div>
      </div>

      <%= render partial: "clinic_management/prescriptions/force_confirmation_button", locals: {
        title: "Enviar Confirmações de Hoje",
        description: "Força o envio das mensagens de confirmação para os agendamentos de hoje para os que não receberam",
        button_path: clinic_management.force_confirmation_today_path,
        confirm_message: "Tem certeza que deseja enviar as mensagens de confirmação para HOJE? Isso pode enviar mensagens duplicadas se já foram enviadas.",
        instance_2_connected: @instance_2_connected,
        target_scope: "today"
      } %>

      <%= render partial: "clinic_management/prescriptions/force_confirmation_button", locals: {
        title: "Enviar Lembretes de Hoje",
        description: "Força o envio das mensagens de lembrete para os agendamentos de hoje para os que não receberam",
        button_path: clinic_management.force_reminder_today_path,
        confirm_message: "Tem certeza que deseja enviar as mensagens de lembrete para HOJE? Isso pode enviar mensagens duplicadas se já foram enviadas.",
        instance_2_connected: @instance_2_connected,
        button_label: "Enviar Lembretes"
      } %>

<% end %>

<%#= link_to 'Ver receita em PDF', pdf_appointment_prescription_path(@prescription.appointment, format: :pdf), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
<br>
<br>
<% if @services.present? %>
  <%= render "clinic_management/shared/day_metrics",
             services: @services,
             dom_id: "today-day-metrics",
             show_header: true,
             show_fit_patient: !doctor?(current_user),
             show_service_link: true %>

  <% wrapper_controllers = doctor?(current_user) ? "doctor-attendance-filter" : "service-patients-filter" %>
  <div data-controller="<%= wrapper_controllers %>"
       <%= 'data-doctor-attendance-filter-active-value="present"'.html_safe if doctor?(current_user) %>
       data-service-patients-filter-active-value="all">

    <% search_context_params = { service_location_id: current_service_location_id.to_s, service_ids: @services.map(&:id) } %>
    <%= render "clinic_management/shared/patients_list_header",
               services: @services,
               search_url: search_index_today_path(search_context_params),
               search_hidden_fields: {
                 service_location_id: current_service_location_id.to_s,
                 "service_ids[]" => @services.map(&:id)
               },
               search_input_id: "search-results",
               doctor_mode: doctor?(current_user),
               dom_id: "today-patients-list-header" %>

    <%# ESSENTIAL: Results and prescription in flow (not absolute) so prescription is never cut off by overlay. %>
    <div class="search-and-results-wrapper">
      <div id="appointments-results" style="margin-bottom: 50px;" class="mt-2 w-full rounded-lg overflow-hidden [&:empty]:hidden [&:not(:empty)]:bg-white [&:not(:empty)]:border [&:not(:empty)]:border-gray-200 [&:not(:empty)]:shadow-md"></div>
      <div id="appointment-info" class="mt-4 min-h-0"></div>
    </div>

    <% @rows.each_with_index do |rows, index| %>
      <% if @services.size > 1 && !doctor?(current_user) %>
        <%= render partial: "clinic_management/shared/action_links", locals: {
          service: @services[index],
          show_fit_patient: true
        } %>
      <% end %>

      <%# Renderiza tabela ou cartões conforme a escolha %>
      <% if @view_type == 'cards' %>
        <%= render partial: "today_cards", locals: { rows: [rows], services: [@services[index]] } %>
      <% else %>
        <div data-service-patients-filter-target="period" <%= 'data-doctor-attendance-filter-target="period"'.html_safe if doctor?(current_user) %>>
          <% if @services.size > 1 %>
            <h3 class="text-lg font-semibold text-slate-700 mb-3 px-2"><%= @services[index].start_time.strftime('%H:%M') %>h às <%= @services[index].end_time.strftime('%H:%M') %>h</h3>
          <% end %>
          <div data-controller="table">
            <%= data_table(rows, 3) %>
          </div>
          <% if doctor?(current_user) %>
            <p data-doctor-attendance-filter-target="empty"
               class="hidden bg-white rounded-xl border border-slate-200 shadow-sm p-4 my-3 text-base text-slate-700">
              Nenhum paciente agendado
            </p>
          <% else %>
            <p data-service-patients-filter-target="empty"
               class="hidden bg-white rounded-xl border border-slate-200 shadow-sm p-4 my-3 text-sm text-slate-600 text-center">
              Nenhum paciente encontrado neste filtro.
            </p>
          <% end %>
        </div>
        <br>
      <% end %>
    <% end %>
  </div>
<% else %>
  <br>
  <p>Nenhum atendimento para hoje encontrado.</p>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggleButton = document.getElementById('toggleOrderNumbers');
    const container = document.getElementById('orderNumbersContainer');
    const quickJump = document.getElementById('quickJump');
    
    toggleButton.addEventListener('click', function() {
      container.classList.toggle('hidden');
    });
    
    quickJump.addEventListener('change', function() {
      const value = this.value;
      if (value) {
        window.open('<%= generate_order_pdf_path(order_number: 0, format: :pdf) %>'.replace('order_number=0', 'order_number=' + value), '_blank');
        this.value = '';
      }
    });
  });
</script>
