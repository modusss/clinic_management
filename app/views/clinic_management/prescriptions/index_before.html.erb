<%# Toggle for table/cards view. Stores preference in a cookie. %>
<%= render partial: "clinic_management/shared/toggle_cards_table", locals: { 
      path: ->(args = {}) { clinic_management.index_before_path(args) }, 
      cookie_name: "preferred_prescriptions_before_view", 
      view_type: @view_type 
    } %>

<% if @services.present? %>
  <% @rows.each_with_index do |rows, index| %>
    <% service = @services[index] %>
    <div data-controller="service-patients-filter" data-service-patients-filter-active-value="all" class="mb-8">
      <%= render "clinic_management/shared/day_metrics",
                 services: [service],
                 dom_id: "service-day-metrics-#{service.id}",
                 show_header: true,
                 show_fit_patient: false,
                 show_service_link: true %>

      <%= render "clinic_management/shared/patients_list_header",
                 services: [service],
                 dom_id: "service-patients-list-header-#{service.id}" %>

      <% if @view_type == 'cards' %>
        <%= render partial: "today_cards", locals: { rows: [rows], services: [service] } %>
      <% else %>
        <div data-service-patients-filter-target="period" data-controller="table">
          <%= data_table(rows, 3) %>
          <p data-service-patients-filter-target="empty"
             class="hidden bg-white rounded-xl border border-slate-200 shadow-sm p-4 my-3 text-sm text-slate-600 text-center">
            Nenhum paciente encontrado neste filtro.
          </p>
        </div>
      <% end %>
    </div>
    <hr class="my-6">
  <% end %>
<% else %>
  <p>Nenhum atendimento anterior encontrado.</p>
<% end %> 