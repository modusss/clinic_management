<%= render partial: "clinic_management/shared/toggle_cards_table", locals: { 
      path: ->(args = {}) { clinic_management.index_next_path(args) }, 
      cookie_name: "preferred_prescriptions_next_view", 
      view_type: @view_type 
    } %>

<%# Force confirmation button - only for non-doctor users %>
<% unless doctor?(current_user) %>
  <% if @next_date.present? %>
    <% next_date_formatted = @next_date.strftime("%d/%m/%Y") %>
    <%= render partial: "clinic_management/prescriptions/force_confirmation_button", locals: {
      title: "Enviar Confirmações do Próximo Dia",
      description: "Força o envio das mensagens de confirmação para os agendamentos de #{next_date_formatted} para os que não receberam",
      button_path: clinic_management.force_confirmation_next_path,
      confirm_message: "Tem certeza que deseja enviar as mensagens de confirmação para #{next_date_formatted}? Isso pode enviar mensagens duplicadas se já foram enviadas.",
      instance_2_connected: @instance_2_connected,
      target_scope: "next"
    } %>
  <% end %>
<% end %>

<%# Shows all services for the next available day after today %>
<% if @services.present? %>
  <% @rows.each_with_index do |rows, index| %>
    <% service = @services[index] %>
    <div data-controller="service-patients-filter" data-service-patients-filter-active-value="all" class="mb-8">
      <%= render "clinic_management/shared/day_metrics",
                 services: [service],
                 dom_id: "service-day-metrics-#{service.id}",
                 show_header: true,
                 show_fit_patient: true,
                 show_service_link: true %>

      <%= render "clinic_management/shared/patients_list_header",
                 services: [service],
                 dom_id: "service-patients-list-header-#{service.id}" %>

      <%# Renderiza tabela ou cartões conforme a escolha %>
      <% if @view_type == 'cards' %>
        <%= render partial: "today_cards", locals: { rows: [rows], services: [service] } %>
      <% else %>
        <div data-service-patients-filter-target="period" data-controller="table">
          <%= data_table(rows, 3) %>
          <p data-service-patients-filter-target="empty"
             class="hidden bg-white rounded-xl border border-slate-200 shadow-sm p-4 my-3 text-sm text-slate-600 text-center">
            Nenhum paciente encontrado neste filtro.
          </p>
        </div>
      <% end %>
    </div>
    <hr class="my-6">
  <% end %>
<% else %>
  <p>Nenhum atendimento futuro encontrado.</p>
<% end %> 