<div class="absent-status-toast" role="status" data-controller="flash">
  <i class="fas fa-check-circle" aria-hidden="true"></i>
  <span><%= message %></span>
  <button type="button" aria-label="Fechar notificação" data-action="click->flash#close">
    <i class="fas fa-times" aria-hidden="true"></i>
  </button>
</div>
