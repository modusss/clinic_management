<% drawer_id = "lpvoz-result-#{lead.id}" %>
<% if operation.blank? %>
  <%= button_to "Ligar",
      clinic_management.lpvoz_call_lead_path(lead),
      method: :post,
      class: "rounded-lg bg-blue-700 px-4 py-2 text-sm font-bold text-white hover:bg-blue-800" %>
<% elsif operation.status.in?(%w[queued dispatching accepted in_progress]) %>
  <span class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1.5 text-sm font-bold text-blue-700">
    <span class="h-2 w-2 rounded-full bg-blue-600"></span>
    <%= operation.in_progress? ? "Em ligação" : "Enviado" %>
  </span>
<% elsif operation.completed? && operation.result["rescheduled"] %>
  <div class="text-sm">
    <p class="font-bold text-emerald-700">Reagendado</p>
    <p class="text-slate-600"><%= l(Time.zone.parse(operation.result["scheduled_at"]), format: "%d/%m às %H:%M") rescue "Concluído" %></p>
    <button type="button" class="mt-1 font-bold text-blue-700 underline" onclick="document.getElementById('<%= drawer_id %>').showModal()">Ver resultado</button>
  </div>
<% elsif operation.needs_attention? %>
  <div class="text-sm"><p class="font-bold text-amber-700">Precisa de atenção</p><p class="text-slate-600"><%= operation.result["summary"].presence || "Revisão necessária" %></p><button type="button" class="mt-1 font-bold text-blue-700 underline" onclick="document.getElementById('<%= drawer_id %>').showModal()">Revisar</button></div>
<% else %>
  <div class="text-sm"><p class="font-bold text-slate-700"><%= operation.failed? ? "Falha" : "Concluída" %></p><p class="max-w-52 text-slate-500"><%= operation.result["summary"].presence || operation.last_error.presence || "Sem remarcação" %></p><button type="button" class="mt-1 font-bold text-blue-700 underline" onclick="document.getElementById('<%= drawer_id %>').showModal()">Ver resultado</button></div>
<% end %>

<% if operation&.terminal? %>
  <dialog id="<%= drawer_id %>" class="ml-auto mr-0 h-full max-h-none w-full max-w-md p-0 backdrop:bg-slate-950/40">
    <div class="flex min-h-full flex-col bg-white p-6 text-left shadow-2xl">
      <header class="flex items-center justify-between border-b border-slate-200 pb-4">
        <div><p class="text-sm font-bold text-emerald-700">LPVoz</p><h3 class="text-2xl font-black text-slate-950">Resultado</h3></div>
        <form method="dialog"><button class="rounded-lg border border-slate-300 px-3 py-2 font-bold" aria-label="Fechar resultado">Fechar</button></form>
      </header>
      <div class="mt-6 flex-1">
        <p class="text-xl font-black <%= operation.result['rescheduled'] ? 'text-emerald-700' : 'text-slate-900' %>">
          <%= operation.result["rescheduled"] ? "Reagendado" : operation.needs_attention? ? "Precisa de atenção" : operation.failed? ? "Falha" : "Concluída" %>
        </p>
        <% if operation.result["scheduled_at"].present? %>
          <p class="mt-3 text-3xl font-black text-slate-950"><%= l(Time.zone.parse(operation.result["scheduled_at"]), format: "%d/%m às %H:%M") rescue operation.result["scheduled_at"] %></p>
        <% end %>
        <p class="mt-5 rounded-xl bg-slate-50 p-4 text-slate-700"><%= operation.result["summary"].presence || operation.last_error.presence || "Operação concluída sem observações adicionais." %></p>
        <% if operation.result["rescheduled"] %>
          <p class="mt-5 rounded-xl border border-emerald-200 bg-emerald-50 p-4 font-bold text-emerald-800">Agendamento validado pelo LPÓticas.</p>
        <% end %>
      </div>
      <% if operation.lpvoz_detail_url.present? %>
        <%= link_to "Abrir detalhes no LPVoz", operation.lpvoz_detail_url, target: "_blank", rel: "noopener", class: "mt-6 rounded-xl bg-blue-700 px-5 py-3 text-center font-bold text-white" %>
      <% end %>
    </div>
  </dialog>
<% end %>
