<% content_for :footer, @company_name.presence || "Clínica" %>

<% breadcrumb(
  { title: "Lista de hoje", path: clinic_management.index_today_path },
  { title: "Equipe em campo" }
) %>

<div class="field-tracking-page space-y-6">
  <div class="field-tracking-page__header bg-white rounded-xl shadow-md border border-gray-200 overflow-hidden">
    <div class="bg-gradient-to-r from-emerald-800 to-emerald-700 px-6 py-4 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h1 class="text-xl font-semibold text-white flex items-center gap-2">
          <i class="fas fa-map-marked-alt" aria-hidden="true"></i>
          Equipe em campo
        </h1>
        <p class="text-emerald-100 text-sm mt-1">
          <%= @active_shifts.size %>
          <%= @active_shifts.size == 1 ? "captador ativo agora" : "captadores ativos agora" %>
        </p>
      </div>
      <%= link_to clinic_management.field_tracking_history_path,
          class: "inline-flex items-center gap-2 rounded-lg bg-white/10 hover:bg-white/20 text-white text-sm font-medium px-4 py-2 transition-colors" do %>
        <i class="fas fa-history" aria-hidden="true"></i>
        Histórico
      <% end %>
    </div>
  </div>

  <div class="field-tracking-layout">
    <aside class="field-tracking-layout__list" aria-label="Captadores ativos">
      <% if @active_shifts.any? %>
        <ul class="field-tracking-shift-list">
          <% @active_shifts.each do |shift| %>
            <% last_point = shift.last_track_point %>
            <li class="field-tracking-shift-list__item">
              <div class="field-tracking-shift-list__name"><%= shift.referral&.name %></div>
              <div class="field-tracking-shift-list__meta">
                <span class="field-tracking-badge field-tracking-badge--active">Em campo</span>
                <% if shift.started_at.present? %>
                  <span>Início <%= l(shift.started_at, format: :short) %></span>
                <% end %>
              </div>
              <% if last_point %>
                <div class="field-tracking-shift-list__location text-xs text-gray-500 mt-1">
                  Último ponto <%= l(last_point.recorded_at, format: :short) %>
                </div>
              <% else %>
                <div class="field-tracking-shift-list__location text-xs text-amber-600 mt-1">
                  Aguardando primeiro ponto GPS
                </div>
              <% end %>
              <%= link_to "Ver expediente",
                  clinic_management.field_tracking_shift_path(shift),
                  class: "field-tracking-shift-list__link" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="field-tracking-empty">
          <p>Nenhum captador com expediente ativo no momento.</p>
          <%= link_to "Ver histórico", clinic_management.field_tracking_history_path, class: "field-tracking-empty__link" %>
        </div>
      <% end %>
    </aside>

    <div class="field-tracking-layout__map">
      <div id="field-tracking-map"
           class="field-tracking-map"
           data-controller="field-tracking-map"
           data-field-tracking-map-live-url-value="<%= clinic_management.field_tracking_path(format: :json) %>"
           data-field-tracking-map-poll-interval-value="45000"
           role="region"
           aria-label="Mapa ao vivo da equipe em campo"></div>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
