<% content_for :title, "Detalhes da rota" %>
<% content_for :footer, @company_name.presence || "Clínica" %>

<% breadcrumb(
  { title: "Lista de hoje", path: clinic_management.index_today_path },
  { title: "Equipe em campo", path: clinic_management.field_tracking_path },
  { title: @shift.referral&.name.presence || "Expediente" }
) %>

<% initial_route_point = @last_point %>
<% first_point_accuracy_label = if @first_point&.accuracy_meters&.positive?
                                  "± #{number_with_precision(@first_point.accuracy_meters, precision: 0)} m"
                                else
                                  "Não informada"
                                end %>
<% first_point_speed_label = if @first_point&.speed_mps.present? && @first_point.speed_mps.to_f >= 0
                               "#{( @first_point.speed_mps.to_f * 3.6).round(1).to_s.tr('.', ',')} km/h"
                             else
                               "Não informada"
                             end %>
<% first_point_stay_label = if @first_point_stay
                              @first_point_stay.label
                            elsif @points_count.positive?
                              "Não estimável neste ponto"
                            else
                              "Aguardando GPS"
                            end %>

<div class="field-tracking-page field-tracking-detail"
     data-controller="field-tracking-map"
     data-field-tracking-map-points-url-value="<%= clinic_management.field_tracking_shift_path(@shift, format: :json) %>"
     data-field-tracking-map-shift-active-value="<%= @shift.active? %>"
     <% if initial_route_point %>
       data-field-tracking-map-initial-latitude-value="<%= initial_route_point.latitude %>"
       data-field-tracking-map-initial-longitude-value="<%= initial_route_point.longitude %>"
     <% end %>
     data-field-tracking-map-poll-interval-value="30000">
  <div class="field-tracking-detail__overview">
    <div class="field-tracking-detail__header">
      <div>
        <h1 class="text-xl font-semibold text-white flex items-center gap-2">
          <i class="fas fa-route" aria-hidden="true"></i>
          <%= @shift.referral&.name %>
        </h1>
        <p>
          Expediente
          <% if @shift.active? %>
            em andamento
          <% else %>
            concluído
          <% end %>
        </p>
      </div>
      <div class="field-tracking-detail__actions">
        <%= link_to "Histórico", clinic_management.field_tracking_history_path, class: "field-tracking-page__header-link" %>
        <%= link_to "Ao vivo", clinic_management.field_tracking_path, class: "field-tracking-page__header-link" %>
      </div>
    </div>

    <div class="field-tracking-detail__metrics">
      <%= render "clinic_management/field_tracking/shift_metrics", shift: @shift %>
    </div>
  </div>

  <div class="field-tracking-map-card field-tracking-show-map-card">
    <div class="field-tracking-map-card__header">
      <div>
        <strong>Linha do tempo da rota</strong>
        <span>Arraste o controle para acompanhar posição, horário e permanência aproximada.</span>
      </div>
      <span class="field-tracking-timeline__point-count">
        <b data-field-tracking-map-target="pointsCount"><%= @points_count %></b> pontos GPS
      </span>
    </div>

    <div class="field-tracking-map field-tracking-map--show"
         data-field-tracking-map-target="map"
         role="region"
         aria-label="Mapa da linha do tempo do expediente"></div>

    <section class="field-tracking-timeline" aria-label="Controles da linha do tempo da rota">
        <div class="field-tracking-timeline__summary" aria-live="polite">
          <div>
            <span class="field-tracking-timeline__eyebrow">Posição selecionada</span>
            <strong class="field-tracking-timeline__timestamp" data-field-tracking-map-target="timestamp">
              <%= @first_point ? l(@first_point.recorded_at, format: :long) : "Aguardando GPS" %>
            </strong>
          </div>
          <span class="field-tracking-timeline__position" data-field-tracking-map-target="position">
            <%= @points_count.positive? ? "Ponto 1 de #{@points_count}" : "Nenhum ponto recebido" %>
          </span>
        </div>

        <div class="field-tracking-timeline__transport">
          <button type="button"
                  class="field-tracking-timeline__step-button"
                  data-action="field-tracking-map#previousPoint"
                  data-field-tracking-map-target="previousButton"
                  <%= "disabled" if @points_count <= 1 %>
                  aria-label="Voltar um ponto">
            <i class="fas fa-step-backward" aria-hidden="true"></i>
          </button>
          <button type="button"
                  class="field-tracking-timeline__play-button"
                  data-action="field-tracking-map#togglePlayback"
                  data-field-tracking-map-target="playButton"
                  <%= "disabled" if @points_count <= 1 %>
                  aria-pressed="false">
            <i class="fas fa-play" data-field-tracking-map-target="playIcon" aria-hidden="true"></i>
            <span data-field-tracking-map-target="playLabel">Reproduzir</span>
          </button>
          <button type="button"
                  class="field-tracking-timeline__step-button"
                  data-action="field-tracking-map#nextPoint"
                  data-field-tracking-map-target="nextButton"
                  <%= "disabled" if @points_count <= 1 %>
                  aria-label="Avançar um ponto">
            <i class="fas fa-step-forward" aria-hidden="true"></i>
          </button>

          <input type="range"
                 class="field-tracking-timeline__slider"
                 min="0"
                 max="<%= [@points_count - 1, 0].max %>"
                 value="0"
                 step="1"
                 <%= "disabled" if @points_count <= 1 %>
                 data-action="input->field-tracking-map#seek change->field-tracking-map#seek"
                 data-field-tracking-map-target="slider"
                 aria-label="Posição na linha do tempo da rota">
        </div>

        <dl class="field-tracking-timeline__details">
          <div class="field-tracking-timeline__detail">
            <dt><i class="fas fa-hourglass-half" aria-hidden="true"></i> Permanência aproximada</dt>
            <dd data-field-tracking-map-target="stayDuration"><%= first_point_stay_label %></dd>
          </div>
          <div class="field-tracking-timeline__detail">
            <dt><i class="fas fa-crosshairs" aria-hidden="true"></i> Precisão do GPS</dt>
            <dd data-field-tracking-map-target="selectedAccuracy"><%= first_point_accuracy_label %></dd>
          </div>
          <div class="field-tracking-timeline__detail">
            <dt><i class="fas fa-person-walking" aria-hidden="true"></i> Velocidade registrada</dt>
            <dd data-field-tracking-map-target="selectedSpeed"><%= first_point_speed_label %></dd>
          </div>
        </dl>

        <p class="field-tracking-timeline__disclaimer">
          A permanência é uma estimativa baseada na sequência de pontos próximos e na precisão informada pelo aparelho.
        </p>
    </section>
  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
