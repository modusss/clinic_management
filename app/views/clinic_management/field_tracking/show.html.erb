<% content_for :title, "Detalhes da rota" %>
<% content_for :footer, @company_name.presence || "Clínica" %>

<% breadcrumb(
  { title: "Lista de hoje", path: clinic_management.index_today_path },
  { title: "Equipe em campo", path: clinic_management.field_tracking_path },
  { title: @shift.referral&.name.presence || "Expediente" }
) %>

<div class="field-tracking-page field-tracking-detail"
     data-controller="field-tracking-map"
     data-field-tracking-map-points-url-value="<%= clinic_management.field_tracking_shift_path(@shift, format: :json) %>"
     data-field-tracking-map-poll-interval-value="30000">
  <div class="field-tracking-detail__overview">
    <div class="field-tracking-detail__header">
      <div>
        <h1 class="text-xl font-semibold text-white flex items-center gap-2">
          <i class="fas fa-route" aria-hidden="true"></i>
          <%= @shift.referral&.name %>
        </h1>
        <p>
          Expediente
          <% if @shift.active? %>
            em andamento
          <% else %>
            concluído
          <% end %>
        </p>
      </div>
      <div class="field-tracking-detail__actions">
        <%= link_to "Histórico", clinic_management.field_tracking_history_path, class: "field-tracking-page__header-link" %>
        <%= link_to "Ao vivo", clinic_management.field_tracking_path, class: "field-tracking-page__header-link" %>
      </div>
    </div>

    <div class="field-tracking-detail__metrics">
      <%= render "clinic_management/field_tracking/shift_metrics", shift: @shift %>
    </div>
  </div>

  <div class="field-tracking-map-card field-tracking-show-map-card">
    <div class="field-tracking-map-card__header">
      <div>
        <strong>Rota registrada</strong>
        <span><b data-field-tracking-map-target="pointsCount"><%= @points.size %></b> pontos GPS · atualização automática</span>
      </div>
      <% if @shift.active? %>
        <span class="field-tracking-signal field-tracking-signal--fresh">Expediente ativo</span>
      <% end %>
    </div>
    <div class="field-tracking-map field-tracking-map--show"
         data-field-tracking-map-target="map"
         role="region"
         aria-label="Mapa da rota do expediente"></div>
  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
