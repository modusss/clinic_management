<div id="lpvoz_pairing" class="mt-7 border-t border-slate-200 pt-6">
  <h3 class="text-lg font-black">Conectar</h3>
  <p class="mt-1 text-sm text-slate-600">Gere o código, copie e informe-o junto com a URL desta instalação no LPVoz. Ele expira em 10 minutos e só pode ser usado uma vez.</p>
  <% if pairing_code.present? %>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center">
      <code class="rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-2xl font-black tracking-widest text-emerald-900"><%= pairing_code %></code>
      <span class="rounded-lg bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-800">Expira às <%= l(connection.pairing_expires_at, format: "%H:%M") %></span>
    </div>
  <% end %>
  <div class="mt-4"><%= button_to(pairing_code.present? ? "Gerar outro" : "Gerar código temporário", generate_pairing_code_lpvoz_integration_path, class: "rounded-xl bg-blue-700 px-5 py-3 font-bold text-white") %></div>
</div>
