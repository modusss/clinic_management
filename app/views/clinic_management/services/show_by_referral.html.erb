<% if referral? current_user %>
  <%= breadcrumb({title: "Painel de conversões", path: main_app.referral_path(user_referral)}, {title: "Atendimentos de " + @referral.name, path: index_by_referral_services_path(@referral)}, {title: @service.date.strftime("%d/%m/%Y"), path: nil}) %>
<% else %>
  <%= breadcrumb({title: "Todos os atendimentos", path: services_path}, {title: "Atendimentos de " + @referral.name, path: index_by_referral_services_path(@referral)}, {title: @service.date.strftime("%d/%m/%Y"), path: nil}) %>
<% end %>

<%= render partial: "clinic_management/shared/toggle_cards_table", locals: { 
      path: ->(args = {}) { url_for(params.permit!.merge(args)) }, 
      cookie_name: "preferred_service_view", 
      view_type: @view_type 
    } %>

<!-- Restante do código da view -->

<div class="container py-6" data-controller="service-patients-filter" data-service-patients-filter-active-value="all">
  <%= render "clinic_management/shared/day_metrics",
             services: [@service],
             referral: @referral,
             dom_id: "service-referral-day-metrics-#{@service.id}-#{@referral.id}",
             show_header: true,
             show_fit_patient: false,
             show_service_link: false %>

  <div class="mb-4">
    <%# Self-booking share: any user account with feature on; only future/today services (past = explain) %>
    <% if self_booking_enabled_for_current_user? && !@service.canceled %>
      <% if @service.date >= Date.current %>
        <%= render partial: "clinic_management/services/share_self_booking_link",
                   locals: { service: @service, referral_for_link: @referral } %>
      <% else %>
        <div class="mt-4 mb-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="status">
          <p class="font-medium"><i class="fas fa-calendar-times mr-1" aria-hidden="true"></i> Link de auto-marcação indisponível para este dia</p>
          <p class="mt-1 text-amber-800">
            A data deste atendimento (<strong><%= @service.date.strftime("%d/%m/%Y") %></strong>) já passou.
            Só é possível compartilhar o link para atendimentos com data <strong>hoje ou futura</strong>.
          </p>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= render "clinic_management/shared/patients_list_header",
             services: [@service],
             referral: @referral,
             dom_id: "service-referral-patients-list-header-#{@service.id}-#{@referral.id}" %>

  <%# Render table or cards view based on @view_type %>
  <% if @rows.present? %>
    <% if @view_type == 'cards' %>
      <%= render partial: "service_cards", locals: { rows: @rows } %>
    <% else %>
      <div data-service-patients-filter-target="period" class="overflow-hidden border-gray-200 sm:rounded-lg">
        <%= data_table(@rows) %>
        <p data-service-patients-filter-target="empty"
           class="hidden bg-white rounded-xl border border-slate-200 shadow-sm p-4 my-3 text-sm text-slate-600 text-center">
          Nenhum paciente encontrado neste filtro.
        </p>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white shadow sm:rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h2 class="text-xl font-medium text-gray-900">Nenhum convite encontrado.</h2>
        <p class="mt-2 text-sm text-gray-600">Não há convites cadastrados no sistema.</p>
      </div>
    </div>
  <% end %>
</div>

<%# ESSENTIAL: Shared remarcação slot modal for show_by_referral patient rows.
    The "Escolha o dia" trigger in _update_service_form does nothing unless this
    modal (and its Stimulus controller) is in the DOM — same as services#show. %>
<%= render "clinic_management/shared/reschedule_slot_modal",
           modal_id: "reschedule-slot-modal",
           grouped_by_day: group_services_for_slot_modal(reschedule_modal_services) %>

<style>


</style>

<script>

document.addEventListener("DOMContentLoaded", function() { 
    if (window.innerWidth > 1365) {
      var table = document.querySelector('table');
  
      for (let rowIndex in table.rows) {
        let row = table.rows[rowIndex];
        let widths = [];
        let cells = row.cells;
        let cellLength = cells.length;
  
        // Verifique se a linha é par ou ímpar
        let isEvenRow = rowIndex % 2 === 0;
  
        for (let i = 0; i < cellLength; i++) {
          widths.push(cells[i].offsetWidth);
        }
  
        for (let i = 0; i < cellLength; i++) {
          let cell = cells[i];
          if (cell.classList.contains('sticky')) {
            cell.style.position = 'sticky';
            cell.style.left = widths.slice(0, i).reduce((a, b) => a + b, 0) + 'px';
            cell.style.borderBottom = '1px solid #dee2e6';
  
            // Aplicar a cor de fundo baseada na paridade da linha
            cell.style.backgroundColor = isEvenRow ? '#fff' : '#EFF6FF';
          }
        }
      }
    }
  })
  


</script>