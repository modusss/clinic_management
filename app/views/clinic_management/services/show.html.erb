<%= breadcrumb({title: "Todos os atendimentos", path: services_path}, {title: "Atendimento de " + @service.date.strftime("%d/%m"), path: nil}) %>

<%# Toggle for table/cards view. Stores preference in a cookie. %>
<%= render partial: "clinic_management/shared/toggle_cards_table", locals: { 
      path: ->(args = {}) { url_for(params.permit!.merge(args)) }, 
      cookie_name: "preferred_service_view", 
      view_type: @view_type 
    } %>

<!-- Restante do código da view -->

<div class="container py-6" data-controller="service-patients-filter" data-service-patients-filter-active-value="all">
  <%= render "clinic_management/shared/day_metrics",
             services: [@service],
             dom_id: "service-day-metrics-#{@service.id}",
             show_header: true,
             show_fit_patient: true,
             show_service_link: false %>

  <div class="mb-4">
    <% if @service.canceled %>
      <p class="text-red-600 font-bold mb-3">Este atendimento foi cancelado.</p>
    <% end %>

    <%# Self-booking share: any linked account with feature; past dates show explanation %>
    <% if self_booking_enabled_for_current_user? && !@service.canceled %>
      <% if @service.date >= Date.current %>
        <%= render partial: "clinic_management/services/share_self_booking_link", locals: { service: @service } %>
      <% else %>
        <div class="mt-4 mb-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="status">
          <p class="font-medium"><i class="fas fa-calendar-times mr-1" aria-hidden="true"></i> Link de auto-marcação indisponível para este dia</p>
          <p class="mt-1 text-amber-800">
            A data deste atendimento (<strong><%= @service.date.strftime("%d/%m/%Y") %></strong>) já passou.
            Só é possível compartilhar o link para atendimentos com data <strong>hoje ou futura</strong>.
          </p>
        </div>
      <% end %>
    <% end %>

    <% unless @service.appointments.count > 0 %>
      <div class="my-3">
        <%= button_to "Excluir atendimento", service_path(@service), method: :delete, class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg" %>
      </div>
    <% end %>
  </div>

  <%= render "clinic_management/shared/patients_list_header",
             services: [@service],
             search_url: (referral?(current_user) ? nil : search_appointment_path(@service)),
             search_input_id: "search",
             dom_id: "service-patients-list-header-#{@service.id}" %>

  <% unless referral?(current_user) %>
    <div id="appointments-results" style="margin-bottom: 50px;" class="[&:empty]:hidden"></div>
  <% end %>

  <%# Render table or cards view based on @view_type %>
  <% if @rows.present? %>
    <% if @view_type == 'cards' %>
      <%= render partial: "service_cards", locals: { rows: @rows } %>
    <% else %>
      <div data-service-patients-filter-target="period" data-controller="table" class="overflow-hidden border-gray-200 sm:rounded-lg">
        <%= data_table(@rows, 3) %>
        <p data-service-patients-filter-target="empty"
           class="hidden bg-white rounded-xl border border-slate-200 shadow-sm p-4 my-3 text-sm text-slate-600 text-center">
          Nenhum paciente encontrado neste filtro.
        </p>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white shadow sm:rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h2 class="text-xl font-medium text-gray-900">Nenhum convite encontrado.</h2>
        <p class="mt-2 text-sm text-gray-600">Não há convites cadastrados no sistema.</p>
      </div>
    </div>
  <% end %>
  <br>
  <br>
  <br>
  <br>
  <br>
  <br>
  <% if is_manager_above? && @service.date >= Date.current %>
    <% unless @service.canceled %>
      <div class="px-4">
        <%= button_to "Cancelar Atendimento", cancel_service_path(@service), method: :patch, class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
      </div>
    <% end %>
  <% end %>
    <br>
    <br>
</div>

<%# ESSENTIAL: Shared remarcação slot modal for service show patient rows. %>
<%= render "clinic_management/shared/reschedule_slot_modal",
           modal_id: "reschedule-slot-modal",
           grouped_by_day: group_services_for_slot_modal(reschedule_modal_services) %>

<style>
@media screen and (max-width: 767px) {
    .patient-name.nowrap{
        white-space: normal;
    }
}
</style>

